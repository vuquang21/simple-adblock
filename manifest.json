{
  "manifest_version": 3,
  "name": "Simple AdBlock",
  "version": "1.4.0",
  "description": "Blocks ads via domain blocklists with a dashboard to import lists and add custom domains.",
  "minimum_chrome_version": "121",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "webRequest", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "cosmetic-rules.js", "cosmetic.js", "picker.js", "auto-hide.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Simple AdBlock",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "dashboard.html"
}
